# Copy to Platform/.runtime/current-system.env ONLY after restoring the frozen
# runtime layout. This file does not install dependencies or stop services.
platform_local_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
retained_root="${platform_local_root}/.runtime/retained-system"
export PLATFORM_DEMO_BUILD_DIR="${retained_root}/build"
export PLATFORM_DEMO_STATE_DIR="${retained_root}/service"
export PLATFORM_AUTHORING_WORKSPACE="${retained_root}/data/workspace"
export PLATFORM_ENVIRONMENT_REPOSITORY="${retained_root}/data/environments"
export PLATFORM_AUTHORING_REFERENCE_ASSET_ROOT="${platform_local_root}/environment/assets/reference_shallow_water_v1"
export PLATFORM_ALGORITHM_INSTALL_ROOT="${retained_root}/algorithms"
export PLATFORM_BELLHOP_EXECUTABLE="${retained_root}/tools/bellhopcxx2d"
export PLATFORM_FRONTEND_PORT=4182
export PLATFORM_BACKEND_PORT=8012
export PLATFORM_FRONTEND_RELEASE=index-BW1LdsaR.js
export PLATFORM_SOURCE_REVISION=63909d331e32a7d2c9785fc92837632ade9c968c
export PLATFORM_RELEASE_ID=P0-ALG-02-TYPICAL-SYSTEM
